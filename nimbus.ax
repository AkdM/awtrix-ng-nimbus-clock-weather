# @name Nimbus
# @desc Clock with rotating date and outdoor weather
# @version 1.0
# @config lat number "Latitude" default=48.8566 min=-90 max=90 step=0.0001
# @config lon number "Longitude" default=2.3522 min=-180 max=180 step=0.0001
# @config wref number "Weather refresh" default=15 min=5 max=120 unit=min
# @config ddur slider "Date duration" default=10 min=1 max=60 unit=s
# @config wdur slider "Temperature / icon duration" default=3 min=1 max=60 unit=s
# @config tran select "Transition" options=down,up,left,right,wipe,none default=wipe help="down/up: vertical scroll, left/right: horizontal slide"
# @config wc color "Week days color" default=#A3A3A3
# @config wdc color "Current day color" default=#FFFFFF
# @config ssun bool "Week starts Sunday" default=false
# @config tright bool "Clock on the right" default=true
# @config night bool "Night mode" default=false help="Only a red clock and week bar, centered"
# @config nauto bool "Automatic night mode" default=false help="Night mode between the hours below"
# @config nfrom number "Night mode from" default=22 min=0 max=23 unit=h
# @config nto number "Night mode until" default=7 min=0 max=23 unit=h
# @config ntopic text "Night mode MQTT topic" default="" help="Payload on/off, true/false or 1/0 switches the night mode"

import math
import string

class Nimbus
  var hh, mm, cur_min           # displayed time, recomputed when the minute changes
  var tc, ch_c, cb_c, ct_c      # colors from device settings
  var tcol                      # temperature color, follows the temperature
  var wc, wdc, ssun             # week bar config
  var tx, px, cx, wx            # x of the clock, of the 14 px panel area, of the calendar and of the week bar
  var nm, nman                  # night mode on now, and its manual switch (setting or MQTT)
  var ddur, wdur, pticks        # panel durations (seconds) and countdown
  var panel, prev               # 0 = date, 1 = temperature, 2 = icon
  var tran, anim_ms             # transition style and its start, nil when idle
  var wref, wait                # weather refresh period and countdown (seconds)
  var temp, lbl, ico            # last weather reading and its icon name, nil until the first fetch
  var pal, pix                  # built-in icons: palette and pixel art

  def init()
    self.ddur = store.get("ddur", 5)
    self.wdur = store.get("wdur", 3)
    self.pticks = self.ddur
    self.panel = 0
    self.tran = store.get("tran", "wipe")
    self.wref = store.get("wref", 15) * 60
    self.wait = 0
    self.wc = store.get("wc")
    self.wdc = store.get("wdc")
    self.ssun = store.get("ssun")
    # clock on the right mirrors the layout: panel in x 0..13, calendar on the outer edge
    var r = store.get("tright")
    self.tx = r ? 14 : 1
    self.px = r ? 0 : 18
    self.cx = r ? 0 : 21
    self.wx = r ? 12 : 0

    # built-in 8x8 icons: one palette letter per pixel, "." is off, "/" starts the next row
    self.pal = {"Y": 0xFFC800, "O": 0xFF7800, "W": 0xFFFFFF, "L": 0xB4B4B4,
                "G": 0x6E6E6E, "D": 0x3C3C3C, "M": 0xF0DC8C}
    self.pix = {
      "sun":    "...rr/.r....r/..OYYO/r.YYYY.r/r.YYYY.r/..OYYO/.r....r/...rr",
      "night":  "..MM/.MM...S/MMM/MMM/MMM/MMMM/.MMMMMM/..MMM",
      "partly": "...Y..Y/.Y..OYO/...OYYYO/..LLYYYY/.LWWLLYO/LWWWWWL/WWWWWWWL/GLLLLLG",
      "cloudy": "....GG/..GGGGG/.LLGGGGG/LWWLGGGG/WWWWLGGG/WWWWWWL/GLLLLLG",
      "fog1":   "/.LLLLLL//GGGG.GGG//.LLLLLL//GG.GGGG",
      "fog2":   "/LLLLLL//.GGGG.GG//..LLLLLL//.GG.GGGG",
      "cloud":  "...LL/.LLWWL/LLWWWWL/LWWWWWWL/GLLLLLLG",
      "storm":  "...GG/.GGLLGG/GLLLLLLG/DGGGGGGD",
      "bolt":   ".....YY/....YY/...YYYY/....YY/...YY"
    }

    self.nman = store.get("night")
    var nt = store.get("ntopic")
    if nt != nil && size(nt) > 0
      mqtt.subscribe(nt, / t, p -> self.on_night(p))
    end
    self.update()
  end

  def getcolor(name)
    var c = settings.get(name)
    return c == nil ? settings.get("textColor") : c
  end

  def update()
    self.tc = self.getcolor("timeColor")
    self.ch_c = self.getcolor("calendarHeaderColor")
    self.cb_c = self.getcolor("calendarBodyColor")
    self.ct_c = self.getcolor("calendarTextColor")
    if self.temp != nil
      self.lbl = str(round(settings.get("useCelsius") ? self.temp : self.temp * 1.8 + 32)) + "°"
      # hue ramp in °C whatever the display unit: blue up to 10, orange at 20, red from 30
      var t = clamp(round(self.temp), 10, 30)
      self.tcol = hsv(t < 20 ? 200 - (t - 10) * 17 : 30 - (t - 20) * 3, 100, 100)
    end
  end

  def loop()
    self.update()

    # night mode: manual switch, or automatic within hours that may wrap past midnight
    var h = hour()
    var f = store.get("nfrom", 22)
    var t = store.get("nto", 7)
    self.nm = self.nman || store.get("nauto") && h >= 0 && (f > t ? h >= f || h < t : h >= f && h < t)

    self.pticks -= 1
    if self.pticks <= 0
      self.prev = self.panel
      self.panel = (self.panel + 1) % 3
      self.pticks = self.panel == 0 ? self.ddur : self.wdur
      self.anim_ms = now_ms()
    end

    self.wait -= 1
    if self.wait <= 0
      self.wait = 60 # retry in a minute unless on_weather() succeeds
      http.get("http://api.open-meteo.com/v1/forecast?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) +
               "&current=temperature_2m,weather_code,is_day",
               / b, s -> self.on_weather(b, s))
    end
  end

  def on_night(p)
    var v = string.tolower(str(p))
    self.nman = v == "on" || v == "true" || v == "1"
  end

  def on_weather(b, s)
    if s != 200 || b == nil return end
    # the numeric patterns skip the "current_units" block, which holds strings
    var t = re.search("temperature_2m\":([-0-9.]+)", b)
    var c = re.search("weather_code\":([0-9]+)", b)
    var d = re.search("is_day\":([0-9])", b)
    if t == nil || c == nil return end

    var k = int(c[1])
    var n = "sun"
    if k >= 95 n = "storm"
    elif k >= 85 n = "snow"
    elif k >= 80 n = "rain"
    elif k >= 71 n = "snow"
    elif k >= 51 n = "rain"
    elif k >= 45 n = "fog"
    elif k == 3 n = "cloudy"
    elif d != nil && d[1] == "0" n = "night"
    elif k > 0 n = "partly"
    end
    self.ico = n
    self.temp = num(t[1])
    self.wait = self.wref
    self.update()
  end

  def fade(c, p)
    return rgb(int(((c >> 16) & 0xFF) * p), int(((c >> 8) & 0xFF) * p), int((c & 0xFF) * p))
  end

  def draw_art(a, x, y)
    var cx = x
    for i : 0..size(a) - 1
      var ch = a[i]
      if ch == "/"
        y += 1
        cx = x
      else
        var c = self.pal.find(ch)
        if c != nil pixel(cx, y, c) end
        cx += 1
      end
    end
  end

  def draw_icon(n, x, y)
    var t = now_ms()
    self.pal["r"] = (t / 600) % 2 ? 0xFF7800 : 0xFFC800 # sun rays pulse
    self.pal["S"] = (t / 900) % 2 ? 0x505050 : 0xFFFFFF # night star twinkles
    var b = n == "fog" ? ((t / 700) % 2 ? "fog2" : "fog1") : (n == "rain" || n == "snow" ? "cloud" : n)
    self.draw_art(self.pix[b], x, y)
    if n == "storm"
      # the bolt flickers twice, then rests
      var k = t % 1870
      if k < 90 || (k >= 180 && k < 270) self.draw_art(self.pix["bolt"], x, y + 3) end
    elif b == "cloud"
      # drops or flakes fall one row per frame, three columns out of phase
      var r = n == "rain"
      var f = t / (r ? 180 : 350)
      var d = r ? [1, 0, 4, 1, 6, 2] : [1, 0, 3, 2, 6, 1]
      for i : 0..2
        pixel(x + d[i * 2], y + 5 + (f + d[i * 2 + 1]) % 3, r ? 0x2890FF : 0xFFFFFF)
      end
    end
  end

  def draw_panel(p, ox, oy)
    var x = self.px + ox
    if p == 0
      x = self.cx + ox
      rect_fill(x, oy, 11, 2, self.ch_c)
      rect_fill(x, oy + 2, 11, 5, self.cb_c)
      text(x + (day() < 10 ? 4 : 2), oy + 6, str(day()), self.ct_c)
    elif p == 1
      # temperature centered in the panel area, bouncing when wider
      var l = self.lbl == nil ? "--°" : self.lbl
      var c = self.lbl == nil ? 0x666666 : self.tcol
      var w = text_ink_width(l)
      if w > 14
        scroll_text(x, oy + 6, 14, l, c, {"mode": "bounce", "speed": 40})
      else
        text(x + (14 - w) / 2, oy + 6, l, c)
      end
    elif self.ico == nil
      text(x + 6, oy + 6, "?", 0x666666)
    else
      self.draw_icon(self.ico, x + 3, oy)
    end
  end

  def draw()
    if minute() != self.cur_min
      var h = hour()
      var m = minute()
      self.hh = str(h / 10) + str(h % 10)
      self.mm = str(m / 10) + str(m % 10)
      self.cur_min = m
    end

    clear()

    var tx = self.tx
    var wx = self.wx
    var tc = self.tc
    var dc = self.wdc
    var oc = self.wc
    if self.nm
      # night mode: no panel, red clock and week bar centered on the display
      tx = 8
      wx = 6
      tc = 0xFF0000
      dc = 0xFF0000
      oc = 0xC00000
    else
      # panel first, so the clock drawn afterwards stays on top; transitions last 500 ms
      var el = self.anim_ms == nil ? 500 : now_ms() - self.anim_ms
      var tr = self.tran
      if el >= 500 || tr == "none"
        self.anim_ms = nil
        self.draw_panel(self.panel, 0, 0)
      elif tr == "wipe"
        # black sweeps over the old panel, then uncovers the new one
        var k = el * 28 / 500
        if k < 14
          self.draw_panel(self.prev, 0, 0)
          rect_fill(self.px, 0, k, 8, 0x000000)
        else
          self.draw_panel(self.panel, 0, 0)
          rect_fill(self.px + k - 14, 0, 28 - k, 8, 0x000000)
        end
      else
        # scroll by 8 px (down/up) or slide by 14 px (left/right), the new panel following the old one
        var v = tr == "down" || tr == "up"
        var s = tr == "down" || tr == "right" ? 1 : -1
        var n = v ? 8 : 14
        var d = el * n / 500 * s
        var e = d - n * s
        self.draw_panel(self.prev, v ? 0 : d, v ? d : 0)
        self.draw_panel(self.panel, v ? 0 : e, v ? e : 0)
        # hide whatever slid out of the panel area under the clock
        rect_fill(self.px == 0 ? 14 : 0, 0, 18, 8, 0x000000)
      end
    end

    # time, with a colon pulsing on odd seconds
    text(tx, 6, self.hh, tc)
    text(tx + 10, 6, self.mm, tc)
    if second() % 2 > 0
      var frac = (epoch_ms() % 1000) / 1000.0
      text(tx + 8, 6, ":", self.fade(tc, (math.cos(2 * math.pi * frac + math.pi) + 1) * 0.5))
    end

    # week bar under the time: 2 px per day with 1 px gaps, 20 px so it overhangs
    # the clock by 3 px on the panel side (the panel leaves that part of row 7 free)
    var wd = self.ssun ? weekday() : (weekday() + 6) % 7
    for i : 0..6
      var x = wx + i * 3
      line(x, 7, x + 1, 7, i == wd ? dc : oc)
    end
  end
end

return Nimbus()
