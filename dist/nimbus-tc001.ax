# @name Nimbus
# @desc Clock with calendar, weather and room values, like the official Time app
# @author AkdM
# @version 2.0
# @display 32x8
# @config t24 bool "24-hour clock" default=true group="Time"
# @config tlz bool "Leading zero" default=true group="Time"
# @config tampm bool "AM/PM indicator" default=false group="Time" help="12-hour clock; shown in night mode, like the official Time app"
# @config tsep select "Colon" options=steady,blink,pulse default=pulse group="Time"
# @config tcol color "Time color" default=#FFFFFF group="Time"
# @config tright bool "Clock on the right" default=true group="Time"
# @config chc color "Header color" default=#FF0000 group="Calendar"
# @config ctc color "Text color" default=#000000 group="Calendar"
# @config cbc color "Body color" default=#FFFFFF group="Calendar"
# @config wbar bool "Week bar" default=true group="Week bar"
# @config wmon bool "Week starts Monday" default=true group="Week bar"
# @config wtd color "Today" default=#FFFFFF group="Week bar"
# @config wod color "Other weekdays" default=#666666 group="Week bar"
# @config wtw color "Today on a weekend" default=#FFFFFF group="Week bar"
# @config wow color "Other weekend days" default=#666666 group="Week bar"
# @config panels text "Panels" default="date,temp,weather" group="Carousel" help="In order, separated by commas: date, temp, weather, room, humidity"
# @config ddur slider "Date duration" default=10 min=1 max=60 unit=s group="Carousel"
# @config pdur slider "Other panels duration" default=3 min=1 max=60 unit=s group="Carousel"
# @config tran select "Transition" options=wipe,fade,morph,down,up,left,right,none default=wipe group="Carousel"
# @config lat number "Latitude" default=48.8566 min=-90 max=90 step=0.0001 group="Weather"
# @config lon number "Longitude" default=2.3522 min=-180 max=180 step=0.0001 group="Weather"
# @config wref number "Refresh" default=15 min=5 max=120 unit=min group="Weather"
# @config rtopic text "Room temperature MQTT topic" default="" group="Room" help="On the broker set in AWTRIX's MQTT settings. Empty uses the clock's sensor"
# @config htopic text "Humidity MQTT topic" default="" group="Room" help="On the broker set in AWTRIX's MQTT settings. Empty uses the clock's sensor"
# @config rcol color "Room temperature color" default=#FFFFFF group="Room"
# @config hcol color "Humidity color" default=#00AAFF group="Room"
# @config night bool "Night mode" default=false group="Night mode"
# @config nauto bool "Automatic night mode" default=false group="Night mode" help="Between the hours below"
# @config nfrom number "From" default=22 min=0 max=23 unit=h group="Night mode"
# @config nto number "Until" default=7 min=0 max=23 unit=h group="Night mode"
# @config nbar bool "Week bar in night mode" default=true group="Night mode"
# @config npause bool "Pause app rotation in night mode" default=false group="Night mode"
# @config nbri number "Night brightness" default=0 min=0 max=255 group="Night mode" help="0 keeps the device's brightness; otherwise set at night and restored after"
# @config ntopic text "MQTT topic" default="" group="Night mode" help="On the broker set in AWTRIX's MQTT settings. Payload on/off, true/false or 1/0"
import math
import string
var FX = 0
var BY = 7
class Nimbus
  var t24, tlz, tampm, tsep, tcol, chc, ctc, cbc, wbar, wmon, wtd, wod, wtw, wow
  var tran, ddur, pdur, rcol, hcol, nauto, nfrom, nto, nbar, npause, nbri
  var rt, sx, ix, qx, ax, ta, bx
  var mn, hh, mm, ap, xh, yh, dstr, doff, wb, nb
  var plist, pi, cur, prev, left, an
  var val, ls, lw, lx, lc, lf, dirty, tick, uc, sens, rdev, hdev, sopt
  var wx, url, hopt, wref, wait, busy, ico
  var pal, art, font, fall, cut, mine, rank
  var dark, nman, replay
  def init()
    self.t24 = store.get("t24")
    self.tlz = store.get("tlz")
    self.tampm = store.get("tampm")
    self.tsep = ["steady", "blink", "pulse"].find(store.get("tsep"))
    self.tcol = store.get("tcol")
    self.chc = store.get("chc")
    self.ctc = store.get("ctc")
    self.cbc = store.get("cbc")
    self.wbar = store.get("wbar")
    self.wmon = store.get("wmon")
    self.wtd = store.get("wtd")
    self.wod = store.get("wod")
    self.wtw = store.get("wtw")
    self.wow = store.get("wow")
    self.tran = ["wipe", "fade", "morph", "down", "up", "left", "right", "none"].find(store.get("tran"))
    self.ddur = store.get("ddur")
    self.pdur = store.get("pdur")
    self.rcol = store.get("rcol")
    self.hcol = store.get("hcol")
    self.nauto = store.get("nauto")
    self.nfrom = store.get("nfrom")
    self.nto = store.get("nto")
    self.nbar = store.get("nbar")
    self.npause = store.get("npause")
    self.nbri = store.get("nbri")
    var r = store.get("tright")
    self.rt = r
    self.sx = FX + (r ? 0 : 23)
    self.ix = FX + (r ? 0 : 24)
    self.qx = FX + (r ? 3 : 26)
    self.ax = FX + (r ? 0 : 21)
    self.ta = FX + (r ? 9 : 0)
    self.bx = self.ta + 1
    self.mn = -1
    self.plist = []
    for m : re.matchall("[a-z]+", string.tolower(store.get("panels")))
      var i = ["date", "temp", "weather", "room", "humidity"].find(m)
      if i != nil self.plist.push(i) end
    end
    if size(self.plist) == 0 self.plist.push(0) end
    self.pi = -1
    self.cur = -1
    self.left = 0
    self.val = [nil, nil, nil, nil, nil]
    self.ls = [nil, nil, nil, nil, nil]
    self.lw = [0, 0, 0, 0, 0]
    self.lx = [0, 0, 0, 0, 0]
    self.lc = [0, 0, 0, 0, 0]
    self.lf = [nil, nil, nil, nil, nil]
    self.dirty = true
    self.tick = 0
    self.sopt = {"mode": "bounce", "speed": 40}
    self.wx = self.plist.find(1) != nil || self.plist.find(2) != nil
    self.url = "http://api.open-meteo.com/v1/forecast?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) + "&current=temperature_2m,weather_code,is_day"
    self.hopt = {"find": "\"current\":{", "keep": 200}
    self.wref = store.get("wref") * 60
    self.wait = 0
    self.busy = false
    var t = store.get("rtopic")
    self.rdev = size(t) == 0
    if !self.rdev && self.plist.find(3) != nil mqtt.subscribe(t, / tp, pl -> self.on_msg(3, pl)) end
    t = store.get("htopic")
    self.hdev = size(t) == 0
    if !self.hdev && self.plist.find(4) != nil mqtt.subscribe(t, / tp, pl -> self.on_msg(4, pl)) end
    self.sens = (self.rdev && self.plist.find(3) != nil) || (self.hdev && self.plist.find(4) != nil)
    self.pal = [0xFFC800, 0xFF7800, 0xFFFFFF, 0xB4B4B4, 0x6E6E6E, 0x3C3C3C, 0xF0DC8C, 0, 0, 0]
    var keys = "YOWLGDMrS#"
    var glyphs = "0123456789-?%"
    var src = ["...rr/.r....r/..OYYO/r.YYYY.r/r.YYYY.r/..OYYO/.r....r/...rr",
               "..MM/.MM...S/MMM/MMM/MMM/MMMM/.MMMMMM/..MMM",
               "...Y..Y/.Y..OYO/...OYYYO/..LLYYYY/.LWWLLYO/LWWWWWL/WWWWWWWL/GLLLLLG",
               "....GG/..GGGGG/.LLGGGGG/LWWLGGGG/WWWWLGGG/WWWWWWL/GLLLLLG",
               "/.LLLLLL//GGGG.GGG//.LLLLLL//GG.GGGG",
               "/LLLLLL//.GGGG.GG//..LLLLLL//.GG.GGGG",
               "...LL/.LLWWL/LLWWWWL/LWWWWWWL/GLLLLLLG",
               "...GG/.GGLLGG/GLLLLLLG/DGGGGGGD",
               ".....YY/....YY/...YYYY/....YY/...YY",
               "###/#.#/#.#/#.#/###", ".#/##/.#/.#/###", "###/..#/###/#/###", "###/..#/###/..#/###",
               "#.#/#.#/###/..#/..#", "###/#/###/..#/###", "###/#/###/#.#/###", "###/..#/..#/..#/..#",
               "###/#.#/###/#.#/###", "###/#.#/###/..#/###", "//###", "###/..#/.#//.#", "#.#/..#/.#/#/#.#"]
    self.art = []
    self.font = {}
    var i = 0
    while i < size(src)
      var a = src[i]
      var b = bytes()
      var x = 0
      var y = 0
      var j = 0
      while j < size(a)
        var ch = a[j]
        if ch == "/"
          y += 1
          x = 0
        else
          var k = string.find(keys, ch)
          if k >= 0
            b.add(x, 1)
            b.add(y, 1)
            b.add(k, 1)
          end
          x += 1
        end
        j += 1
      end
      if i < 9 self.art.push(b) else self.font[glyphs[i - 9]] = b end
      i += 1
    end
    self.fall = bytes("010004010602010003020601")
    self.rank = bytes()
    var g = 224
    i = 0
    while i < 256
      g = (g * 75 + 74) % 65537
      self.rank.add(g % 100, 1)
      i += 1
    end
    var s = store.get("night")
    if s != store.get("nset")
      store.set("nset", s)
      store.set("nstate", s)
    end
    self.nman = store.get("nstate", s)
    self.replay = true
    t = store.get("ntopic")
    if size(t) > 0 mqtt.subscribe(t, / tp, pl -> self.on_msg(0, pl)) end
  end
  def loop()
    self.left -= 1
    if self.left <= 0
      var n = size(self.plist)
      var i = self.pi
      var k = 1
      while k <= n
        i = (self.pi + k) % n
        var q = self.plist[i]
        if (q != 3 && q != 4) || self.ls[q] != nil break end
        k += 1
      end
      var p = self.plist[i]
      if (p == 3 || p == 4) && self.ls[p] == nil p = 0 end
      self.pi = i
      if p != self.cur
        if self.cur >= 0 self.an = now_ms() end
        self.prev = self.cur
        self.cur = p
      end
      self.left = p == 0 ? self.ddur : self.pdur
    end
    self.wait -= 1
    if self.wx && self.wait <= 0 && !self.busy
      self.busy = true
      self.wait = 60
      http.get(self.url, / b, s -> self.on_weather(b, s), self.hopt)
    end
    self.tick += 1
    if self.sens && self.tick % 10 == 1
      if self.rdev
        var v = sensor.temperature()
        if v != self.val[3]
          self.val[3] = v
          self.dirty = true
        end
      end
      if self.hdev
        var v = sensor.humidity()
        if v != self.val[4]
          self.val[4] = v
          self.dirty = true
        end
      end
    end
    var uc = settings.get("useCelsius")
    if uc != self.uc
      self.uc = uc
      self.dirty = true
    end
    if self.dirty
      self.dirty = false
      var p = 1
      while p < 5
        if p != 2
          var v = self.val[p]
          var s = nil
          var c = p == 3 ? self.rcol : self.hcol
          if p == 1
            if v == nil
              s = "--"
              c = 0x666666
            else
              var t = clamp(round(v), 10, 30)
              c = hsv(t < 20 ? 200 - (t - 10) * 17 : 30 - (t - 20) * 3, 100, 100)
              if !self.uc v = v * 1.8 + 32 end
            end
          elif v != nil && p == 3 && self.rdev && !self.uc
            v = v * 1.8 + 32
          end
          if v != nil s = str(round(v)) + (p == 4 ? "%" : "") end
          self.ls[p] = s
          if s != nil
            var w = p == 4 ? text_width(s) - 1 : 4 * size(s) + 2
            var x = w <= 9 ? (9 - w) / 2 : 0
            self.lx[p] = FX + (self.rt ? x : 32 - x - w)
            self.lw[p] = w
            self.lc[p] = c
            self.lf[p] = p == 4 ? s : s + "°"
          end
        end
        p += 1
      end
    end
    var h = hour()
    var f = self.nfrom
    var t = self.nto
    var dk = self.nman || self.nauto && h >= 0 && (f > t ? h >= f || h < t : h >= f && h < t)
    if dk != self.dark
      self.dark = dk
      if dk && self.npause
        rotation.show()
        rotation.pause()
        store.set("npz", true)
      elif store.get("npz", false)
        rotation.resume()
        store.set("npz", false)
      end
      if dk
        if self.nbri > 0
          if !store.get("nbsave", false)
            store.set("nbsave", [settings.get("autoBrightness"), settings.get("brightness")])
          end
          settings.set("autoBrightness", false)
          settings.set("brightness", self.nbri)
        end
      else
        var sv = store.get("nbsave", false)
        if sv
          settings.set("autoBrightness", sv[0])
          settings.set("brightness", sv[1])
          store.set("nbsave", false)
        end
      end
    end
  end
  def on_weather(b, s)
    self.busy = false
    if s != 200 || b == nil return end
    var t = re.search("temperature_2m\":([-0-9.]+)", b)
    var c = re.search("weather_code\":([0-9]+)", b)
    var d = re.search("is_day\":([0-9])", b)
    if t == nil || c == nil return end
    var k = int(c[1])
    var n = 0
    if k >= 95 n = 7
    elif k >= 85 n = 6
    elif k >= 80 n = 5
    elif k >= 71 n = 6
    elif k >= 51 n = 5
    elif k >= 45 n = 4
    elif k == 3 n = 3
    elif d != nil && d[1] == "0" n = 1
    elif k > 0 n = 2
    end
    self.ico = n
    self.val[1] = num(t[1])
    self.wait = self.wref
    self.dirty = true
  end
  def on_msg(k, p)
    if k == 0
      var v = string.tolower(str(p))
      v = v == "on" || v == "true" || v == "1"
      var r = self.replay
      self.replay = false
      if r && v == store.get("nmqtt") return end
      store.set("nmqtt", v)
      store.set("nstate", v)
      self.nman = v
    else
      var m = re.search("-?[0-9]+[.]?[0-9]*", str(p))
      if m != nil
        self.val[k] = num(m[0])
        self.dirty = true
      end
    end
  end
  def scale(c, l)
    return rgb(int(((c >> 16) & 255) * l + 0.5), int(((c >> 8) & 255) * l + 0.5), int((c & 255) * l + 0.5))
  end
  def put(x, y, w, h, c)
    var j = y
    while j < y + h
      var i = x
      while i < x + w
        if (self.rank[((j & 7) << 5) | (i & 31)] < self.cut) == self.mine pixel(i, j, c) end
        i += 1
      end
      j += 1
    end
  end
  def panel(p, ox, oy, l)
    if p < 0 return end
    var nat = self.cut == nil
    var s = nil
    var c = 0
    var x = 0
    var y = oy + 6
    if p == 0
      x = self.sx + ox
      var b = self.cbc
      var h = self.chc
      if l < 1
        b = self.scale(b, l)
        h = self.scale(h, l)
      end
      if nat
        rect_fill(x, oy, 9, 8, b)
        rect_fill(x, oy, 9, 2, h)
      else
        self.put(x, oy, 9, 8, b)
        self.put(x, oy, 9, 2, h)
      end
      s = self.dstr
      c = self.ctc
      x += self.doff
      y = oy + 7
    elif p == 2
      if self.ico == nil
        s = "?"
        c = 0x666666
        x = self.qx + ox
      else
        var t = now_ms()
        var k = self.ico
        self.pal[7] = (t / 600) % 2 ? 0xFF7800 : 0xFFC800
        self.pal[8] = (t / 900) % 2 ? 0x505050 : 0xFFFFFF
        var bb = self.art[k < 4 ? k : (k == 4 ? 4 + (t / 700) % 2 : (k == 7 ? 7 : 6))]
        var dy = 0
        x = self.ix + ox
        while bb != nil
          var i = 0
          while i < size(bb)
            var cc = self.pal[bb[i + 2]]
            if l < 1 cc = self.scale(cc, l) end
            if nat pixel(x + bb[i], oy + dy + bb[i + 1], cc)
            else self.put(x + bb[i], oy + dy + bb[i + 1], 1, 1, cc) end
            i += 3
          end
          var f = t % 1870
          if k == 7 && dy == 0 && (f < 90 || (f >= 180 && f < 270))
            bb = self.art[8]
            dy = 3
          else
            bb = nil
          end
        end
        if k == 5 || k == 6
          var o = k == 5 ? 0 : 6
          var f = t / (k == 5 ? 180 : 350)
          var cc = k == 5 ? 0x2890FF : 0xFFFFFF
          if l < 1 cc = self.scale(cc, l) end
          var i = 0
          while i < 6
            var px = x + self.fall[o + i]
            var py = oy + 5 + (f + self.fall[o + i + 1]) % 3
            if nat pixel(px, py, cc) else self.put(px, py, 1, 1, cc) end
            i += 2
          end
        end
      end
    else
      s = self.ls[p]
      if s == nil return end
      c = self.lc[p]
      if self.lw[p] > 11
        if nat || (self.cut >= 50) == self.mine
          scroll_text(self.ax + ox, y, 11, self.lf[p], l < 1 ? self.scale(c, l) : c, self.sopt)
        end
        return
      end
      x = self.lx[p] + ox
      if p != 4
        var cc = l < 1 ? self.scale(c, l) : c
        var dx = x + 4 * size(s)
        if nat rect_fill(dx, oy + 1, 2, 2, cc) else self.put(dx, oy + 1, 2, 2, cc) end
      end
    end
    if s != nil
      if l < 1 c = self.scale(c, l) end
      if nat
        text(x, y, s, c)
      else
        var i = 0
        while i < size(s)
          var g = self.font[s[i]]
          var j = 0
          while j < size(g)
            self.put(x + i * 4 + g[j], y - 5 + g[j + 1], 1, 1, c)
            j += 3
          end
          i += 1
        end
      end
    end
  end
  def draw()
    if minute() != self.mn
      var h = hour()
      var m = minute()
      self.mn = m
      var ap = h < 12 ? " AM" : " PM"
      if !self.t24
        h = h % 12
        if h == 0 h = 12 end
      end
      self.hh = (self.tlz && h < 10 ? "0" : "") + str(h)
      self.mm = (m < 10 ? "0" : "") + str(m)
      self.ap = !self.t24 && self.tampm ? ap : nil
      var w = text_width(self.hh) + 2 + text_width(self.mm) - 1
      self.xh = self.ta + (23 - w) / 2
      if self.ap != nil w += text_width(self.ap) end
      self.yh = FX + (32 - w) / 2
      var d = day()
      self.dstr = str(d)
      self.doff = d < 10 ? 3 : 1
      var wd = weekday()
      self.wb = []
      self.nb = []
      var i = 0
      while i < 7
        var c = self.wmon ? (i + 1) % 7 : i
        var we = c == 0 || c == 6
        self.wb.push(c == wd ? (we ? self.wtw : self.wtd) : (we ? self.wow : self.wod))
        self.nb.push(c == wd ? 0xFF0000 : 0xC00000)
        i += 1
      end
    end
    clear()
    var dk = self.dark
    if !dk
      var el = self.an == nil ? 500 : now_ms() - self.an
      var tr = self.tran
      if el >= 500 || tr == 7
        self.an = nil
        self.panel(self.cur, 0, 0, 1)
      else
        var a = self.ax
        if tr == 0
          var k = el * 22 / 500
          if k < 11
            self.panel(self.prev, 0, 0, 1)
            if k > 0 rect_fill(a, 0, k, 8, 0) end
          else
            self.panel(self.cur, 0, 0, 1)
            rect_fill(a + k - 11, 0, 22 - k, 8, 0)
          end
        elif tr == 1
          self.panel(el < 250 ? self.prev : self.cur, 0, 0, (math.cos(2 * math.pi * el / 500.0) + 1) * 0.5)
        elif tr == 2
          self.cut = el / 5
          self.mine = false
          self.panel(self.prev, 0, 0, 1)
          self.mine = true
          self.panel(self.cur, 0, 0, 1)
          self.cut = nil
        else
          var v = tr < 5
          var s = tr == 3 || tr == 6 ? 1 : -1
          var n = v ? 8 : 11
          var d = el * n / 500 * s
          var e = d - n * s
          self.panel(self.prev, v ? 0 : d, v ? d : 0, 1)
          self.panel(self.cur, v ? 0 : e, v ? e : 0, 1)
        end
        if a > 0 rect_fill(0, 0, a, 8, 0) end
        if a + 11 < width() rect_fill(a + 11, 0, width() - a - 11, 8, 0) end
        if height() > 8 rect_fill(a, 8, 11, height() - 8, 0) end
      end
    end
    var tc = dk ? 0xFF0000 : self.tcol
    var x = dk ? self.yh : self.xh
    x += text(x, 6, self.hh, tc)
    var lv = 1
    if self.tsep == 1
      lv = second() % 2 ? 0 : 1
    elif self.tsep == 2
      lv = 0.5 * (1 - math.cos(2 * math.pi * (epoch_ms() % 2000) / 2000.0))
    end
    if lv > 0 text(x, 6, ":", lv < 1 ? self.scale(tc, lv) : tc) end
    x += 2
    x += text(x, 6, self.mm, tc)
    if dk && self.ap != nil text(x, 6, self.ap, tc) end
    if dk ? self.nbar : self.wbar
      var sw = dk ? 3 : 2
      var bx = dk ? FX + 2 : self.bx
      var cl = dk ? self.nb : self.wb
      var i = 0
      while i < 7
        line(bx, BY, bx + sw - 1, BY, cl[i])
        bx += sw + 1
        i += 1
      end
    end
  end
end
return Nimbus()
