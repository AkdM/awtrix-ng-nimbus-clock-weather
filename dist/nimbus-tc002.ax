# @name Nimbus
# @desc Clock with calendar, weather and room values, like the official Time app
# @author AkdM
# @version 2.0
# @display 52x16
# @config t24 bool "24-hour clock" default=true group="Time"
# @config tlz bool "Leading zero" default=true group="Time"
# @config tsep select "Colon" options=steady,blink,pulse default=pulse group="Time"
# @config tcol color "Time color" default=#FFFFFF group="Time"
# @config face select "Clock face" options=sheet,ring,flap,big default=sheet group="Time"
# @config chc color "Header color" default=#FF0000 group="Calendar"
# @config ctc color "Text color" default=#000000 group="Calendar"
# @config cbc color "Body color" default=#FFFFFF group="Calendar"
# @config canim bool "Calendar animation" default=true group="Calendar" help="The sheet is torn off when Nimbus appears and at midnight"
# @config dfmt select "Date format" options=dd.mm.yy,mm/dd/yy,yy-mm-dd default=dd.mm.yy group="Calendar" help="Big face"
# @config wbar bool "Week bar" default=true group="Week bar"
# @config wmon bool "Week starts Monday" default=true group="Week bar"
# @config wtd color "Today" default=#FFFFFF group="Week bar"
# @config wod color "Other weekdays" default=#666666 group="Week bar"
# @config wtw color "Today on a weekend" default=#FFFFFF group="Week bar"
# @config wow color "Other weekend days" default=#666666 group="Week bar"
# @config panels text "Panels" default="date,temp,weather" group="Carousel" help="In order, separated by commas: date, temp, weather, room, humidity"
# @config ddur slider "Date duration" default=10 min=1 max=60 unit=s group="Carousel"
# @config pdur slider "Other panels duration" default=3 min=1 max=60 unit=s group="Carousel"
# @config tran select "Transition" options=wipe,fade,morph,down,up,left,right,none default=wipe group="Carousel"
# @config lat number "Latitude" default=48.8566 min=-90 max=90 step=0.0001 group="Weather"
# @config lon number "Longitude" default=2.3522 min=-180 max=180 step=0.0001 group="Weather"
# @config wref number "Refresh" default=15 min=5 max=120 unit=min group="Weather"
# @config wlang select "Condition words" options=English,Español,Français,Português,Deutsch default=English group="Weather" help="Big face"
# @config wtext text "Your own words" default="" group="Weather" help="Big face. In this order, separated by commas: clear, partly cloudy, cloudy, fog, rain, snow, storm; an empty one keeps the word above"
# @config rtopic text "Room temperature MQTT topic" default="" group="Room" help="Empty uses the clock's sensor"
# @config htopic text "Humidity MQTT topic" default="" group="Room" help="Empty uses the clock's sensor"
# @config rcol color "Room temperature color" default=#FFFFFF group="Room"
# @config hcol color "Humidity color" default=#00AAFF group="Room"
# @config night bool "Night mode" default=false group="Night mode"
# @config nauto bool "Automatic night mode" default=false group="Night mode" help="Between the hours below"
# @config nfrom number "From" default=22 min=0 max=23 unit=h group="Night mode"
# @config nto number "Until" default=7 min=0 max=23 unit=h group="Night mode"
# @config nbar bool "Week bar in night mode" default=true group="Night mode"
# @config npause bool "Pause app rotation in night mode" default=false group="Night mode"
# @config nbri number "Night brightness" default=0 min=0 max=255 group="Night mode" help="0 keeps the device's brightness; otherwise set at night and restored after"
# @config ntopic text "MQTT topic" default="" group="Night mode" help="Payload on/off, true/false or 1/0"

import math
import string


class Nimbus
  # settings, read once in init()
  var t24, tlz, tampm, tsep, tcol, chc, ctc, cbc, wbar, wmon, wtd, wod, wtw, wow
  var tran, ddur, pdur, rcol, hcol, nauto, nfrom, nto, nbar, npause, nbri
  # face (0 sheet, 1 ring, 2 flap, 3 big), tear-off on, date format (0 dd.mm.yy, 1 mm/dd/yy,
  # 2 yy-mm-dd), flap card colors (the time color at 18 % and 28 %)
  var face, canim, dfmt, fbg, ffc
  # fonts as runs (see runs()) by character: small font and chunky; output row -> glyph row of
  # the double-size time, the big face's time and the flap cards; weekday and month names,
  # weather conditions and their x on the bottom row
  var sf, cf, r2, rb, rf, wdn, mon, words, wpx
  # rebuilt once a minute: minute, time text, rectangles of the big time and of the double-size
  # time (digits, colon), flap cards (steady rectangles, masks now and a minute ago, turning),
  # week bar colors by day and at night
  var mn, tt, bd, bc, sd, sc, ft, fa, fo, ff, wb, nb
  # rebuilt once a day: day, today's and yesterday's sheet (rows of runs), the bottom row's
  # weekday, date and its x; tear-off start (nil when none); time of the last frame
  var dd, today, yday, wds, dts, dx, tear, seen
  # label font by panel number: 0 chunky, 1 small, 2 bouncing
  var lk
  # carousel: panel numbers (0 date, 1 temp, 2 weather, 3 room, 4 humidity), index in it,
  # panel shown and previous one, seconds left, start of the transition (nil when none)
  var plist, pi, cur, prev, left, an
  # values (index = panel number), their labels, label widths, x, colors and full texts
  # for the firmware's bounce scroll; dirty = labels to rebuild in loop()
  var val, ls, lw, lx, lc, lf, dirty, tick, uc, sens, rdev, hdev, sopt
  # weather: needed, request, options, refresh period, seconds left, request in flight, icon
  var wx, url, hopt, wref, wait, busy, ico
  # built-in icons: palette, compiled art, morph font, drops and flakes; morph state
  var pal, art, font, fall, cut, mine, rank
  # night mode: shown now (nil until the first loop), manual switch, MQTT replay pending
  var dark, nman, replay

  def init()
    # settings: read once, saving them restarts the app
    self.t24 = store.get("t24")
    self.tlz = store.get("tlz")
    self.tsep = ["steady", "blink", "pulse"].find(store.get("tsep"))
    self.tcol = store.get("tcol")
    self.chc = store.get("chc")
    self.ctc = store.get("ctc")
    self.cbc = store.get("cbc")
    self.wbar = store.get("wbar")
    self.wmon = store.get("wmon")
    self.wtd = store.get("wtd")
    self.wod = store.get("wod")
    self.wtw = store.get("wtw")
    self.wow = store.get("wow")
    self.tran = ["wipe", "fade", "morph", "down", "up", "left", "right", "none"].find(store.get("tran"))
    self.ddur = store.get("ddur")
    self.pdur = store.get("pdur")
    self.rcol = store.get("rcol")
    self.hcol = store.get("hcol")
    self.nauto = store.get("nauto")
    self.nfrom = store.get("nfrom")
    self.nto = store.get("nto")
    self.nbar = store.get("nbar")
    self.npause = store.get("npause")
    self.nbri = store.get("nbri")

    self.face = ["sheet", "ring", "flap", "big"].find(store.get("face"))
    self.canim = store.get("canim")
    self.dfmt = ["dd.mm.yy", "mm/dd/yy", "yy-mm-dd"].find(store.get("dfmt"))
    self.fbg = self.scale(self.tcol, 0.18)
    self.ffc = self.scale(self.tcol, 0.28)
    self.lk = [0, 0, 0, 0, 0]
    self.mn = -1
    # carousel
    self.plist = []
    for m : re.matchall("[a-z]+", string.tolower(store.get("panels")))
      var i = ["date", "temp", "weather", "room", "humidity"].find(m)
      if i != nil self.plist.push(i) end
    end
    if size(self.plist) == 0 self.plist.push(0) end
    self.pi = -1
    self.cur = -1
    self.left = 0
    self.val = [nil, nil, nil, nil, nil]
    self.ls = [nil, nil, nil, nil, nil]
    self.lw = [0, 0, 0, 0, 0]
    self.lx = [0, 0, 0, 0, 0]
    self.lc = [0, 0, 0, 0, 0]
    self.lf = [nil, nil, nil, nil, nil]
    self.dirty = true
    self.tick = 0
    self.sopt = {"mode": "bounce", "speed": 40}

    # weather, only when a panel shows it
    self.wx = self.plist.find(1) != nil || self.plist.find(2) != nil
    self.url = "http://api.open-meteo.com/v1/forecast?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) + "&current=temperature_2m,weather_code,is_day"
    self.hopt = {"find": "\"current\":{", "keep": 200}
    self.wref = store.get("wref") * 60
    self.wait = 0
    self.busy = false

    # room values: an MQTT topic, or the clock's own sensor when the topic is empty
    var t = store.get("rtopic")
    self.rdev = size(t) == 0
    if !self.rdev && self.plist.find(3) != nil mqtt.subscribe(t, / tp, pl -> self.on_msg(3, pl)) end
    t = store.get("htopic")
    self.hdev = size(t) == 0
    if !self.hdev && self.plist.find(4) != nil mqtt.subscribe(t, / tp, pl -> self.on_msg(4, pl)) end
    self.sens = (self.rdev && self.plist.find(3) != nil) || (self.hdev && self.plist.find(4) != nil)

    # built-in 8x8 icons: one letter per pixel ("." is off), "/" starts the next row, compiled
    # once into bytes of (x, y, palette index) for each lit pixel; palette entries 7 and 8 change
    # while drawing (sun rays, star)
    self.pal = [0xFFC800, 0xFF7800, 0xFFFFFF, 0xB4B4B4, 0x6E6E6E, 0x3C3C3C, 0xF0DC8C, 0, 0, 0]
    var keys = "YOWLGDMrS#"
    var glyphs = "0123456789-?%"
    var src = ["...rr/.r....r/..OYYO/r.YYYY.r/r.YYYY.r/..OYYO/.r....r/...rr",          # 0 sun
               "..MM/.MM...S/MMM/MMM/MMM/MMMM/.MMMMMM/..MMM",                       # 1 clear night
               "...Y..Y/.Y..OYO/...OYYYO/..LLYYYY/.LWWLLYO/LWWWWWL/WWWWWWWL/GLLLLLG", # 2 partly cloudy
               "....GG/..GGGGG/.LLGGGGG/LWWLGGGG/WWWWLGGG/WWWWWWL/GLLLLLG",          # 3 cloudy
               "/.LLLLLL//GGGG.GGG//.LLLLLL//GG.GGGG",                             # 4 fog
               "/LLLLLL//.GGGG.GG//..LLLLLL//.GG.GGGG",                            # 5 fog, second frame
               "...LL/.LLWWL/LLWWWWL/LWWWWWWL/GLLLLLLG",                           # 6 rain and snow cloud
               "...GG/.GGLLGG/GLLLLLLG/DGGGGGGD",                                  # 7 storm cloud
               ".....YY/....YY/...YYYY/....YY/...YY",                              # 8 bolt, from row 3
               # the firmware's small font for the morph: 0-9, "-", "?", "%"
               "###/#.#/#.#/#.#/###", ".#/##/.#/.#/###", "###/..#/###/#/###", "###/..#/###/..#/###",
               "#.#/#.#/###/..#/..#", "###/#/###/..#/###", "###/#/###/#.#/###", "###/..#/..#/..#/..#",
               "###/#.#/###/#.#/###", "###/#.#/###/..#/###", "//###", "###/..#/.#//.#", "#.#/..#/.#/#/#.#"]
    self.art = []
    self.font = {}
    var i = 0
    while i < size(src)
      var a = src[i]
      var b = bytes()
      var x = 0
      var y = 0
      var j = 0
      while j < size(a)
        var ch = a[j]
        if ch == "/"
          y += 1
          x = 0
        else
          var k = string.find(keys, ch)
          if k >= 0
            b.add(x, 1)
            b.add(y, 1)
            b.add(k, 1)
          end
          x += 1
        end
        j += 1
      end
      if i < 9 self.art.push(b) else self.font[glyphs[i - 9]] = b end
      i += 1
    end
    # drops (rain) then flakes (snow): column and phase of three falling pixels
    self.fall = bytes("010004010602010003020601")
    # random order in which the pixels switch during a morph
    self.rank = bytes()
    var g = 224 # seed picked so the switches spread evenly over the transition
    i = 0
    while i < 256
      g = (g * 75 + 74) % 65537
      self.rank.add(g % 100, 1)
      i += 1
    end
    # fonts of the time, the sheets and the labels as runs: the small font (its digits, "-", "?"
    # and "%" are the morph font above), its capitals, ":", "." and "/"; chunky digits, "-", ":"
    self.sf = {}
    i = 0
    while i < 13
      self.sf[glyphs[i]] = self.runs(src[9 + i])
      i += 1
    end
    var caps = ["##/#.#/###/#.#/#.#", "##/#.#/##/#.#/##", ".#/#.#/#/#.#/.#", "##/#.#/#.#/#.#/##",
                "###/#/###/#/###", "###/#/###/#/#", ".##/#/#.#/#.#/.##", "#.#/#.#/###/#.#/#.#",
                "#/#/#/#/#", "..#/..#/..#/#.#/.#", "#.#/#.#/##/#.#/#.#", "#/#/#/#/###",
                "#...#/##.##/#.#.#/#...#/#...#", "#..#/##.#/#.##/#..#/#..#", ".#/#.#/#.#/#.#/.#",
                "###/#.#/##/#/#", ".#/#.#/#.#/#.#/.###", "###/#.#/##/#.#/#.#", "###/#/###/..#/###",
                "###/.#/.#/.#/.#", "#.#/#.#/#.#/#.#/###", "#.#/#.#/#.#/#.#/.#",
                "#...#/#...#/#...#/#.#.#/.#.#", "#.#/#.#/.#/#.#/#.#", "#.#/#.#/###/..#/##",
                "###/..#/.#/#/###"]
    i = 0
    while i < 26
      self.sf["ABCDEFGHIJKLMNOPQRSTUVWXYZ"[i]] = self.runs(caps[i])
      i += 1
    end
    self.sf[":"] = self.runs("/#//#")
    self.sf["."] = self.runs("////#")
    self.sf["/"] = self.runs("..#/..#/.#/#/#")
    var ck = ["#####/#...#/#...#/#...#/#...#/#...#/#####", "..#/.##/..#/..#/..#/..#/#####",
              "#####/....#/....#/#####/#/#/#####", "#####/....#/....#/#####/....#/....#/#####",
              "#...#/#...#/#...#/#####/....#/....#/....#", "#####/#/#/#####/....#/....#/#####",
              "#####/#/#/#####/#...#/#...#/#####", "#####/....#/....#/....#/....#/....#/....#",
              "#####/#...#/#...#/#####/#...#/#...#/#####",
              "#####/#...#/#...#/#####/....#/....#/#####", "///#####", "/##/##//##/##"]
    self.cf = {}
    i = 0
    while i < 12
      self.cf["0123456789-:"[i]] = self.runs(ck[i])
      i += 1
    end
    # output row -> glyph row: double size, the big face (only the three bars doubled), the flap
    # cards (255: the dark split row)
    self.r2 = bytes("00000101020203030404")
    self.rb = bytes("00000102030304050606")
    self.rf = bytes("0000010102FF0203030404")
    self.wdn = "SUNMONTUEWEDTHUFRISAT"
    self.mon = "JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC"
    # night mode switch: the setting or MQTT, whichever changed last; kept in the store so it
    # survives restarts
    var s = store.get("night")
    if s != store.get("nset")
      store.set("nset", s)
      store.set("nstate", s)
    end
    self.nman = store.get("nstate", s)
    self.replay = true
    t = store.get("ntopic")
    if size(t) > 0 mqtt.subscribe(t, / tp, pl -> self.on_msg(0, pl)) end
  end

  def loop()
    # carousel: the next listed panel that has something to show, the date if none has
    self.left -= 1
    if self.left <= 0
      var n = size(self.plist)
      var i = self.pi
      var k = 1
      while k <= n
        i = (self.pi + k) % n
        var q = self.plist[i]
        if (q != 3 && q != 4) || self.ls[q] != nil break end
        k += 1
      end
      var p = self.plist[i]
      if (p == 3 || p == 4) && self.ls[p] == nil p = 0 end
      self.pi = i
      if p != self.cur
        if self.cur >= 0 self.an = now_ms() end
        self.prev = self.cur
        self.cur = p
      end
      self.left = p == 0 ? self.ddur : self.pdur
    end

    # weather: one request in flight, retried after a minute unless on_weather() succeeds
    self.wait -= 1
    if self.wx && self.wait <= 0 && !self.busy
      self.busy = true
      self.wait = 60
      http.get(self.url, / b, s -> self.on_weather(b, s), self.hopt)
    end

    # the clock's own sensors, every 10 s, only when a room panel uses them
    self.tick += 1
    if self.sens && self.tick % 10 == 1
      if self.rdev
        var v = sensor.temperature()
        if v != self.val[3]
          self.val[3] = v
          self.dirty = true
        end
      end
      if self.hdev
        var v = sensor.humidity()
        if v != self.val[4]
          self.val[4] = v
          self.dirty = true
        end
      end
    end
    var uc = settings.get("useCelsius")
    if uc != self.uc
      self.uc = uc
      self.dirty = true
    end

    if self.dirty
      # labels of the temperature, room temperature and humidity panels
      self.dirty = false
      var p = 1
      while p < 5
        if p != 2
          var v = self.val[p]
          var s = nil
          var c = p == 3 ? self.rcol : self.hcol
          if p == 1
            if v == nil
              s = "--"
              c = 0x666666
            else
              # color from the temperature in °C: blue up to 10, orange at 20, red from 30
              var t = clamp(round(v), 10, 30)
              c = hsv(t < 20 ? 200 - (t - 10) * 17 : 30 - (t - 20) * 3, 100, 100)
              if !self.uc v = v * 1.8 + 32 end
            end
          elif v != nil && p == 3 && self.rdev && !self.uc
            v = v * 1.8 + 32
          end
          if v != nil s = str(round(v)) + (p == 4 ? "%" : "") end
          self.ls[p] = s
          if s != nil
            self.lc[p] = c
            self.lf[p] = p == 4 ? s : s + "°"
          end
        end
        p += 1
      end
    end
    # night mode: the manual switch, or the automatic hours (the window may wrap past midnight)
    var h = hour()
    var f = self.nfrom
    var t = self.nto
    var dk = self.nman || self.nauto && h >= 0 && (f > t ? h >= f || h < t : h >= f && h < t)
    if dk != self.dark
      self.dark = dk
      # the rotation pause belongs to the firmware and outlives a restart (saving the settings
      # restarts the app), so whether Nimbus set it is kept in the store
      if dk && self.npause
        rotation.show()
        rotation.pause()
        store.set("npz", true)
      elif store.get("npz", false)
        rotation.resume()
        store.set("npz", false)
      end
      if dk
        if self.nbri > 0
          if !store.get("nbsave", false)
            store.set("nbsave", [settings.get("autoBrightness"), settings.get("brightness")])
          end
          settings.set("autoBrightness", false)
          settings.set("brightness", self.nbri)
        end
      else
        var sv = store.get("nbsave", false)
        if sv
          settings.set("autoBrightness", sv[0])
          settings.set("brightness", sv[1])
          store.set("nbsave", false)
        end
      end
    end
  end

  def on_weather(b, s)
    self.busy = false
    if s != 200 || b == nil return end
    var t = re.search("temperature_2m\":([-0-9.]+)", b)
    var c = re.search("weather_code\":([0-9]+)", b)
    var d = re.search("is_day\":([0-9])", b)
    if t == nil || c == nil return end
    var k = int(c[1])
    var n = 0
    if k >= 95 n = 7
    elif k >= 85 n = 6
    elif k >= 80 n = 5
    elif k >= 71 n = 6
    elif k >= 51 n = 5
    elif k >= 45 n = 4
    elif k == 3 n = 3
    elif d != nil && d[1] == "0" n = 1
    elif k > 0 n = 2
    end
    self.ico = n
    self.val[1] = num(t[1])
    self.wait = self.wref
    self.dirty = true
  end

  # MQTT message: k 0 = night mode switch, 3 room temperature, 4 humidity
  def on_msg(k, p)
    if k == 0
      var v = string.tolower(str(p))
      v = v == "on" || v == "true" || v == "1"
      # the first message after a restart can be the broker replaying its retained message:
      # skip it if that value was already applied, so a later change of the setting still wins
      var r = self.replay
      self.replay = false
      if r && v == store.get("nmqtt") return end
      store.set("nmqtt", v)
      store.set("nstate", v)
      self.nman = v
    else
      # the first number in the message, so "21.5", "21.5 °C" and {"temperature": 21.5} work
      var m = re.search("-?[0-9]+[.]?[0-9]*", str(p))
      if m != nil
        self.val[k] = num(m[0])
        self.dirty = true
      end
    end
  end

  # color c at brightness l (0..1), each channel rounded like the firmware does
  def scale(c, l)
    return rgb(int(((c >> 16) & 255) * l + 0.5), int(((c >> 8) & 255) * l + 0.5), int((c & 255) * l + 0.5))
  end

  # morph: the pixels of a rectangle that already belong to the panel being drawn
  def put(x, y, w, h, c)
    var j = y
    while j < y + h
      var i = x
      while i < x + w
        if (self.rank[((j & 7) << 5) | (i & 31)] < self.cut) == self.mine pixel(i, j, c) end
        i += 1
      end
      j += 1
    end
  end

  # an art string ("#" lit, "/" starts the next row) as bytes: its width, then (x, y, length)
  # of each horizontal run of lit pixels
  def runs(a)
    var b = bytes("00")
    var y = 0
    for r : string.split(a, "/")
      var x = 0
      while x < size(r)
        if r[x] == "#"
          var n = 1
          while x + n < size(r) && r[x + n] == "#" n += 1 end
          b.add(x, 1)
          b.add(y, 1)
          b.add(n, 1)
          if x + n > b[0] b[0] = x + n end
          x += n
        else
          x += 1
        end
      end
      y += 1
    end
    return b
  end

  # ink width of s in font f: the glyphs and 1 px between them
  def wid(s, f)
    var w = -1
    var i = 0
    while i < size(s)
      w += f[s[i]][0] + 1
      i += 1
    end
    return w
  end

  # a time on the official clock's cells, centred in w px from x, top row top: a digit takes the
  # widest digit's width, the colon its own, every glyph column doubled and the glyph rows
  # mapped through rows (output row -> glyph row); gap between digits, cg around the colon.
  # Returns the digits and the colon as rectangles (x, y, w, h) for rects()
  def cells(s, f, rows, gap, cg, x, w, top)
    var n = size(s)
    var dw = f["0"][0] * 2
    var tw = 0
    var i = 0
    while i < n
      tw += (s[i] == ":" ? f[":"][0] * 2 : dw) + (i + 1 < n ? (s[i] == ":" || s[i + 1] == ":" ? cg : gap) : 0)
      i += 1
    end
    x += (w - tw) / 2
    var dg = bytes()
    var co = bytes()
    i = 0
    while i < n
      var ch = s[i]
      var g = f[ch]
      var cw = ch == ":" ? g[0] * 2 : dw
      var gx = x + (cw - g[0] * 2) / 2
      var b = ch == ":" ? co : dg
      var j = 1
      while j < size(g)
        var r = 0
        while r < size(rows)
          if rows[r] == g[j + 1]
            var r0 = r
            while r < size(rows) && rows[r] == g[j + 1] r += 1 end
            b.add(gx + 2 * g[j], 1)
            b.add(top + r0, 1)
            b.add(2 * g[j + 2], 1)
            b.add(r - r0, 1)
          else
            r += 1
          end
        end
        j += 3
      end
      x += cw + (i + 1 < n ? (ch == ":" || s[i + 1] == ":" ? cg : gap) : 0)
      i += 1
    end
    return [dg, co]
  end

  # the rectangles (x, y, w, h) of b, filled with c
  def rects(b, c)
    var i = 0
    while i < size(b)
      rect_fill(b[i], b[i + 1], b[i + 2], b[i + 3], c)
      i += 4
    end
  end

  # the flap face's cards: the hours at x 17 and the minutes at x 36, split by a dark row 8;
  # cc: colon color or nil
  def flap(c, cc)
    var k = 0
    while k < 2
      var x = k == 0 ? 17 : 36
      rect_fill(x, 0, 16, 8, self.fbg)
      rect_fill(x, 9, 16, 7, self.fbg)
      self.rects(self.ft[k], c)
      k += 1
    end
    if cc != nil
      pixel(34, 5, cc)
      pixel(34, 11, cc)
    end
  end

  def draw()
    if minute() != self.mn
      # once a minute: the time cells, the flap cards and the week bar; once a day the sheets
      # and the bottom row's date
      var h = hour()
      var m = minute()
      self.mn = m
      if !self.t24
        h = h % 12
        if h == 0 h = 12 end
      end
      var tt = (self.tlz && h < 10 ? "0" : "") + str(h) + ":" + (m < 10 ? "0" : "") + str(m)
      self.tt = tt
      var b = self.cells(tt, self.cf, self.rb, 2, 1, 0, 52, 0)
      self.bd = b[0]
      self.bc = b[1]
      var f = self.face
      if f == 2
        var c = string.find(tt, ":")
        self.ft = [self.cells(tt[0 .. c - 1], self.sf, self.rf, 2, 2, 17, 16, 3)[0],
                   self.cells(tt[c + 1 ..], self.sf, self.rf, 2, 2, 36, 16, 3)[0]]
      elif f < 2
        b = self.cells(tt, self.sf, self.r2, 2, 2, 17, 34, self.wbar ? 2 : 3)
        self.sd = b[0]
        self.sc = b[1]
      end
      var wd = weekday()
      self.wb = []
      self.nb = []
      var i = 0
      while i < 7
        var c = self.wmon ? (i + 1) % 7 : i     # day shown in column i, 0 = Sunday
        var we = c == 0 || c == 6
        self.wb.push(c == wd ? (we ? self.wtw : self.wtd) : (we ? self.wow : self.wod))
        self.nb.push(c == wd ? 0xFF0000 : 0xC00000)
        i += 1
      end
    end

    clear()
    var dk = self.dark
    var f = self.face

    # time: the big face's at night and on the big face, the flap cards, or double size next to
    # the sheet; the colon steady, blinking or pulsing like the official app
    var tc = dk ? 0xFF0000 : self.tcol
    var lv = 1
    if self.tsep == 1
      lv = second() % 2 ? 0 : 1
    elif self.tsep == 2
      lv = 0.5 * (1 - math.cos(2 * math.pi * (epoch_ms() % 2000) / 2000.0))
    end
    var cc = lv <= 0 ? nil : (lv < 1 ? self.scale(tc, lv) : tc)
    if dk || f == 3
      self.rects(self.bd, tc)
      if cc != nil self.rects(self.bc, cc) end
    elif f == 2
      self.flap(tc, cc)
    else
      self.rects(self.sd, tc)
      if cc != nil self.rects(self.sc, cc) end
    end

    # week bar: 4 px segments on row 15, under the time next to a sheet, centred at night
    if dk ? self.nbar : (self.wbar && f < 2)
      var bx = dk ? 9 : 17
      var cl = dk ? self.nb : self.wb
      var i = 0
      while i < 7
        rect_fill(bx, 15, 4, 1, cl[i])
        bx += 5
        i += 1
      end
    end
  end
end

return Nimbus()
